{
    "model_name": "telugu_hindi_summarizer",
    "model_type": "encoder_decoder",
    "vocab_size": 32000,
    "max_position_embeddings": 512,
    "hidden_size": 384,
    "num_hidden_layers": 6,
    "num_attention_heads": 6,
    "intermediate_size": 1536,
    "hidden_dropout_prob": 0.1,
    "attention_probs_dropout_prob": 0.1,
    "initializer_range": 0.02,
    "layer_norm_eps": 1e-12,
    "pad_token_id": 0,
    "bos_token_id": 1,
    "eos_token_id": 2,
    "training": {
        "batch_size": 32,
        "learning_rate": 5e-5,
        "warmup_steps": 1000,
        "max_steps": 50000,
        "save_steps": 5000,
        "eval_steps": 1000
    },
    "languages": ["te", "hi"],
    "task": "summarization"
}
